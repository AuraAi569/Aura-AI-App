[app]
title = Aura AI
package.name = auraai
package.domain = org.aura
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 1.0.0
requirements = python3,kivy,google-genai,requests,urllib3,certifi,idna,charset-normalizer
orientation = portrait
fullscreen = 0
android.permissions = INTERNET

[buildozer]
log_level = 2
warn_on_root = 1
